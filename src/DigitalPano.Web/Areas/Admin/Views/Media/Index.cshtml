@model MediaListViewModel
@{
    ViewData["Title"] = "Medya";
}

<div class="page-heading">
    <div>
        <p class="admin-eyebrow">İçerik yönetimi</p>
        <h1>Medya kütüphanesi</h1>
        <p class="text-secondary mb-0">Duyurularda kullanılacak görsel ve videoları yönetin.</p>
    </div>
    <a asp-action="Upload" class="btn btn-primary">Dosya yükle</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (Model.Items.Count == 0)
{
    <div class="content-panel empty-state">
        <h2>Henüz medya yok</h2>
        <p>JPEG, PNG, WebP görsel veya MP4 video yükleyebilirsiniz.</p>
        <a asp-action="Upload" class="btn btn-primary">İlk dosyayı yükle</a>
    </div>
}
else
{
    <div class="media-grid">
        @foreach (MediaListItemViewModel item in Model.Items)
        {
            <article class="media-card">
                <div class="media-thumbnail">
                    @if (item.MediaType == MediaType.Image)
                    {
                        <img src="@Url.Action("Preview", "Media", new { area = "Admin", id = item.Id })" alt="@item.OriginalFileName" loading="lazy" />
                    }
                    else
                    {
                        <video preload="metadata" muted>
                            <source src="@Url.Action("Preview", "Media", new { area = "Admin", id = item.Id })" type="@item.MimeType" />
                        </video>
                        <span class="video-indicator">MP4 VİDEO</span>
                    }
                </div>
                <div class="media-card-body">
                    <strong title="@item.OriginalFileName">@item.OriginalFileName</strong>
                    <span>@FormatBytes(item.FileSize) · @item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    <span>@(item.UsageCount == 0 ? "Kullanılmıyor" : $"{item.UsageCount} duyuruda kullanılıyor")</span>
                    <div class="mt-3 d-flex gap-2">
                        <a asp-action="Preview" asp-route-id="@item.Id" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary">Ön izle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger @(item.UsageCount > 0 ? "disabled" : null)" aria-disabled="@(item.UsageCount > 0)">Sil</a>
                    </div>
                </div>
            </article>
        }
    </div>
}

@functions {
    private static string FormatBytes(long bytes)
    {
        return bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.##} MB"
            : $"{bytes / 1024d:0.##} KB";
    }
}
