@model MediaDeleteViewModel
@{
    ViewData["Title"] = "Medya Sil";
}

<div class="page-heading">
    <div>
        <p class="admin-eyebrow">Medya</p>
        <h1>Dosyayı sil</h1>
    </div>
</div>

<section class="content-panel delete-panel">
    @if (Model.UsageCount > 0)
    {
        <div class="alert alert-danger">Bu dosya @Model.UsageCount duyuruda kullanıldığı için silinemez.</div>
    }
    else
    {
        <div class="alert alert-warning">Bu işlem fiziksel dosyayı ve medya kaydını kalıcı olarak siler.</div>
    }
    <h2>@Model.OriginalFileName</h2>
    <p>@(Model.MediaType == MediaType.Image ? "Görsel" : "Video") · @($"{Model.FileSize / 1024d / 1024d:0.##} MB")</p>
    <div class="form-actions justify-content-start">
        @if (Model.UsageCount == 0)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">Evet, dosyayı sil</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</section>
