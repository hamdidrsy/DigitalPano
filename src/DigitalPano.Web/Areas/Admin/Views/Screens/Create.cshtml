@model ScreenFormViewModel
@{
    ViewData["Title"] = "Yeni Ekran";
}

<div class="page-heading">
    <div><p class="admin-eyebrow">Ekranlar</p><h1>Yeni ekran</h1></div>
</div>
<form asp-action="Create" method="post">
    <partial name="_ScreenForm" model="Model" />
    <div class="form-actions justify-content-start">
        <button type="submit" class="btn btn-primary">Ekranı kaydet</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
