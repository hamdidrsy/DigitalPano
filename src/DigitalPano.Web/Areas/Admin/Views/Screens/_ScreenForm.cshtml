@model ScreenFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<section class="content-panel form-section screen-form-panel">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" maxlength="100" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Slug" class="form-label"></label>
        <input asp-for="Slug" class="form-control" maxlength="120" placeholder="Boş bırakılırsa ekran adından üretilir" />
        <div class="form-text">Örnek: giriş-katı. Adres kaydedilirken Türkçe karakterler dönüştürülür.</div>
        <span asp-validation-for="Slug" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" maxlength="200" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
    <div class="form-check form-switch">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
</section>
