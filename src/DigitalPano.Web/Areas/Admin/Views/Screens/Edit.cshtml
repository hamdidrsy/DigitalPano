@model ScreenFormViewModel
@{
    ViewData["Title"] = "Ekran Düzenle";
}

<div class="page-heading">
    <div><p class="admin-eyebrow">Ekranlar</p><h1>Ekranı düzenle</h1></div>
</div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden" />
    <partial name="_ScreenForm" model="Model" />
    <div class="form-actions justify-content-start">
        <button type="submit" class="btn btn-primary">Değişiklikleri kaydet</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
