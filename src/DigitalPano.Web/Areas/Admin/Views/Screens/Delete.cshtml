@model ScreenDeleteViewModel
@{
    ViewData["Title"] = "Ekran Sil";
}

<div class="page-heading"><div><p class="admin-eyebrow">Ekranlar</p><h1>Ekranı sil</h1></div></div>
<section class="content-panel delete-panel">
    @if (Model.AnnouncementCount > 0)
    {
        <div class="alert alert-danger">Bu ekrana @Model.AnnouncementCount duyuru atanmış. Geçmiş ilişkiyi korumak için ekran silinemez; pasif yapabilirsiniz.</div>
    }
    else
    {
        <div class="alert alert-warning">Ekran ve cihaz adresi kalıcı olarak silinecektir.</div>
    }
    <h2>@Model.Name</h2>
    <p class="text-secondary">/pano/@Model.Slug</p>
    <div class="form-actions justify-content-start">
        @if (Model.AnnouncementCount == 0)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">Evet, ekranı sil</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
    </div>
</section>
